{
  "name": "framely",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node init && next dev",
    "build": "node init && npm run brand:site && next build",
    "start": "node init && next start",
    "lint": "eslint",
    "brand:site": "node scripts/brand-exact-site.mjs",
    "prepare:site": "cd saino-exact && npm run prepare:site && cd .. && rsync -a --delete saino-exact/public/assets/ public/assets/ && rsync -a --delete saino-exact/public/site/ public/site/ && npm run brand:site",
    "postinstall": "node -e \"if(!process.env.VERCEL){require('child_process').execSync('npx playwright install chromium',{stdio:'inherit'})}\""
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.152",
    "@sparticuz/chromium": "^153.0.0",
    "@vercel/blob": "^2.9.0",
    "ai": "^7.0.179",
    "cheerio": "^1.2.0",
    "jose": "^6.2.18",
    "jszip": "^3.10.2",
    "next": "16.4.6",
    "playwright": "^1.65.1",
    "playwright-core": "^1.65.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}