# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
!.env.example

# local job storage
.data/

# Framer extract workspaces (run npm run prepare:site to regenerate public/site)
/framer-complete-*/
/saino-exact/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
config.bat