# Local data directory for job files (defaults to ./.data)
# DATA_DIR=/tmp/framer-converter

# Optional: Vercel Blob for zip storage in production
# BLOB_READ_WRITE_TOKEN=

# AI Gateway — enables semantic Next.js/React rewrite during convert
# Create a key in the Vercel dashboard under AI Gateway
AI_GATEWAY_API_KEY=

# Model used for conversion (AI Gateway model string)
AI_CONVERT_MODEL=anthropic/claude-sonnet-4.5

# Force AI path even in environments without a key (not recommended)
# FORCE_AI_CONVERT=0

# Google sign-in (required for extract zip on the marketing site)
# Create OAuth credentials: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random secret for session JWT (e.g. openssl rand -base64 32)
AUTH_SECRET=
# Optional: public site URL for OAuth redirects in production
# AUTH_URL=https://your-domain.com
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback
# Allow extract without sign-in (local only)
# FRAMELY_EXTRACT_OPEN=1
